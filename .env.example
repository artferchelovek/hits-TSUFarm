# Обязательно для Docker Compose
JWT_SECRET=change_this_to_a_random_secret_key

# Опционально (пароль БД, по умолчанию tsufarm_pass)
POSTGRES_PASSWORD=tsufarm_pass

# Для разработки (Vite)
VITE_API_URL=http://localhost:3001/api

# Для сервера (локальный запуск без Docker)
DATABASE_URL=postgres://tsufarm:tsufarm_pass@localhost:5432/tsufarm
PORT=3001
CORS_ORIGIN=http://localhost:8000
